#version 450

// Colour undistortion and Y'CbCr to R'G'B' in one pass (undistort_color.glsl),
// over planes in a buffer (color_planes.glsl): a decoder's I420 or NV12, a
// camera's YUYV or luma staged from the host, or packed R'G'B' words a
// dataset decoded on the host. For packed words, R, G and B are sampled
// bilinearly where the lens puts the pixel, through the same coverage test,
// and kept as they are. A pixel whose ray lies outside the frame's depth
// camera's field of view (rgbd_overlap.glsl's depth_sees) is 0 too.

#extension GL_GOOGLE_include_directive : require
#include "undistort_color.glsl"
#include "color_planes.glsl"
#include "rgbd_overlap.glsl"

// R | G << 8 | B << 16 | coverage << 24, the tsdf tier's colour layout.
layout(set = 0, binding = 1, scalar) writeonly buffer Color { uint color[]; };
// The frame's two cameras.
layout(set = 0, binding = 2, scalar) readonly buffer Overlap {
  RgbdOverlap overlap;
};

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint w = pc.cam.width;
  uint h = pc.cam.height;
  if (gid >= w * h) {
    return;
  }
  vec2 s;
  if (!source_of(gid, s) ||
      !depth_sees(overlap, vec2(float(gid % w), float(gid / w)))) {
    color[gid] = 0u;
    return;
  }
  if (pc.packed_rgb == 0u) {
    color[gid] = ycbcr_word(s);
    return;
  }
  uvec2 lo, hi;
  vec2 f;
  bilinear_taps(w, h, s, lo, hi, f);
  vec3 rgb = bilinear(rgb_at(lo.x, lo.y), rgb_at(hi.x, lo.y),
                      rgb_at(lo.x, hi.y), rgb_at(hi.x, hi.y), f) /
             255.0;
  color[gid] = code(rgb.r) | (code(rgb.g) << 8) | (code(rgb.b) << 16) |
               0xFF000000u;
}
