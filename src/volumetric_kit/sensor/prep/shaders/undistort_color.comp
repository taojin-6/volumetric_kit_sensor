#version 450

// Colour undistortion and Y'CbCr to R'G'B' in one pass. One thread per pixel
// of the pinhole image: find where the lens puts it in the captured picture,
// sample luma and chroma there bilinearly, each at its own siting, and convert
// by the picture's matrix and range. One pass, so no intermediate R'G'B'
// image is written at the captured size. The high byte is the pixel's
// coverage: 0xFF where the lens maps inside the captured picture, 0 where it
// maps outside, which is black and which fusion then skips
// (ColorFrame::coverage_in_alpha) rather than fusing as colour.

#extension GL_GOOGLE_include_directive : require
#include "lens.glsl"

layout(local_size_x = 256) in;

// The three planes packed tightly, each row `width` bytes, four bytes to a
// word: luma at byte 0, Cb at cb_offset, Cr at cr_offset.
layout(set = 0, binding = 0, scalar) readonly buffer Planes { uint planes[]; };
// R | G << 8 | B << 16 | coverage << 24, the tsdf tier's colour layout.
layout(set = 0, binding = 1, scalar) writeonly buffer Color { uint color[]; };

layout(push_constant, scalar) uniform Params {
  LensCamera cam;
  uint cb_offset;  // bytes
  uint cr_offset;  // bytes
  float kr;
  float kb;
  uint full_range;
} pc;

float texel(uint base, uint row_bytes, uint x, uint y) {
  uint i = base + y * row_bytes + x;
  return float((planes[i >> 2] >> ((i & 3u) * 8u)) & 0xFFu);
}

// Bilinear over a plane of w x h texels, centres at integer coordinates,
// clamped to the edge.
float sample_plane(uint base, uint w, uint h, vec2 p) {
  p = clamp(p, vec2(0.0), vec2(float(w - 1u), float(h - 1u)));
  uvec2 a = uvec2(floor(p));
  uvec2 b = min(a + 1u, uvec2(w - 1u, h - 1u));
  vec2 f = p - vec2(a);
  float top = mix(texel(base, w, a.x, a.y), texel(base, w, b.x, a.y), f.x);
  float bottom = mix(texel(base, w, a.x, b.y), texel(base, w, b.x, b.y), f.x);
  return mix(top, bottom, f.y);
}

uint code(float c) { return uint(clamp(c, 0.0, 1.0) * 255.0 + 0.5); }

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint w = pc.cam.width;
  uint h = pc.cam.height;
  if (gid >= w * h) {
    return;
  }
  vec2 s = source_pixel(pc.cam, vec2(float(gid % w), float(gid / w)));
  if (!(s.x >= -0.5 && s.y >= -0.5 && s.x <= float(w) - 0.5 &&
        s.y <= float(h) - 0.5)) {
    color[gid] = 0u;
    return;
  }
  // Chroma sample j sits at luma column 2j, and between luma rows 2j and
  // 2j + 1.
  uint cw = (w + 1u) / 2u;
  uint ch = (h + 1u) / 2u;
  vec2 c = vec2(s.x * 0.5, (s.y - 0.5) * 0.5);
  float y = sample_plane(0u, w, h, s);
  float cb = sample_plane(pc.cb_offset, cw, ch, c);
  float cr = sample_plane(pc.cr_offset, cw, ch, c);

  float luma;
  float pb;
  float pr;
  if (pc.full_range != 0u) {
    luma = y / 255.0;
    pb = (cb - 128.0) / 255.0;
    pr = (cr - 128.0) / 255.0;
  } else {
    luma = (y - 16.0) / 219.0;
    pb = (cb - 128.0) / 224.0;
    pr = (cr - 128.0) / 224.0;
  }
  float kg = 1.0 - pc.kr - pc.kb;
  float r = luma + 2.0 * (1.0 - pc.kr) * pr;
  float b = luma + 2.0 * (1.0 - pc.kb) * pb;
  float g = (luma - pc.kr * r - pc.kb * b) / kg;
  color[gid] = code(r) | (code(g) << 8) | (code(b) << 16) | 0xFF000000u;
}
