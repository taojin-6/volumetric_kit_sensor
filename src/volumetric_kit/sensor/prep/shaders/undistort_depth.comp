#version 450

// Depth undistortion. One thread per pixel of the pinhole image, sampled
// where the lens puts it in the raw image, a sub-pixel position: the bilinear
// mix of the four raw pixels around it where all four hold a return within
// kBlendSpanM of each other, else the nearest raw pixel. The nearest pixel
// alone repeats a raw pixel across neighbours and skips others, so a slope
// comes out in half-pixel terraces, which fusion turns into shading bands on
// floors and walls; the mix follows the surface instead. Between a foreground
// and a background return there is no surface, and a mix there would invent
// one, so a block that spans more, or misses a return, keeps the nearest
// pixel. Z depth is along the optical axis, which undistortion does not move,
// so the value is kept, less the sensor's pc.depth_offset_m (+ where it reads
// too far), per raw pixel before any mix: a return the offset takes to 0 or
// below is no return, and 0 stays no return whatever the offset's sign.
//
// With pc.within_color, set for a frame with colour, the pixel is also kept
// only inside the colour camera's field of view and where the colour pass
// keeps the colour pixel its point lands on. Its direction, turned into the
// colour camera's frame by the rotation alone, must lie on a pinhole pixel
// whose source the colour pass finds in the picture (its rounding and its
// lens test). Its point, at the corrected depth, moved into the colour
// camera by the two poses, must lie in front of it, on a pinhole pixel the
// same test passes and whose ray's direction the depth camera's view holds
// (depth_sees, the colour pass's own test). Elsewhere it is 0, no return, so
// depth survives only where it lands on colour with its coverage byte set.
// The colour camera's view, not its line of sight: nothing here tests
// whether a nearer surface hides the point from it.

#extension GL_GOOGLE_include_directive : require
#include "rgbd_overlap.glsl"

layout(local_size_x = 256) in;

// Raw 16-bit samples, two to a word, little-endian, the image's first at
// sample pc.raw_first of the binding: sample j is the low half of word j/2
// when j is even. The binding starts where a binding's offset may, at or
// below the first sample, so depth left on the device at any even byte is
// read where it is.
layout(set = 0, binding = 0, scalar) readonly buffer Raw { uint raw[]; };
layout(set = 0, binding = 1, scalar) writeonly buffer Depth { float depth[]; };
// The frame's two cameras (rgbd_overlap.glsl), read only under
// pc.within_color.
layout(set = 0, binding = 2, scalar) readonly buffer Overlap {
  RgbdOverlap overlap;
};

layout(push_constant, scalar) uniform Params {
  LensCamera cam;
  float metres_per_unit;
  uint within_color;
  float depth_offset_m;
  uint raw_first;  // the image's first sample in the binding
} pc;

// Whether point or direction `q` of the colour camera's frame lies in front
// of it, on a pinhole pixel whose source the colour pass finds in the
// picture, `r` that pixel: the pass's rounding and lens test. The pinhole is
// sensor/frame/shaders/pinhole.glsl's; the bounds are the colour pass's, so
// the rounded pixel must lie in the image ([-0.5, width - 0.5) before
// rounding), not the pixel itself as vs_project_pinhole asks.
bool color_records(vec3 q, out vec2 r) {
  LensCamera c = overlap.color;
  vec2 px;
  if (!vs_pinhole_pixel(q, vec4(c.fx, c.fy, c.cx, c.cy), px) ||
      !rounds_into(px, c.width, c.height)) {
    return false;
  }
  r = floor(px + 0.5);
  vec2 s = source_pixel(c, r);
  return s.x >= -0.5 && s.y >= -0.5 && s.x <= float(c.width) - 0.5 &&
         s.y <= float(c.height) - 0.5;
}

// Whether depth pinhole pixel `pixel`, `z` metres deep, is kept beside the
// colour: its direction inside the colour camera's view, and the colour
// pixel its point rounds to kept by the colour pass.
bool kept_with_color(vec2 pixel, float z) {
  vec4 k = vec4(pc.cam.fx, pc.cam.fy, pc.cam.cx, pc.cam.cy);
  mat4 m = overlap.depth_to_color;
  vec3 dir = mat3(m) * vs_unproject_pinhole(pixel, 1.0, k);
  vec3 q = (m * vec4(vs_unproject_pinhole(pixel, z, k), 1.0)).xyz;
  vec2 r;
  return color_records(dir, r) && color_records(q, r) && depth_sees(overlap, r);
}

// The largest depth range, in metres, across the four raw pixels of a block
// that is still one surface and mixed; a step past it is an edge. 4 cm is the
// truncation band the rig fuses with, past which fusion's own bilinear depth
// sample falls back to the nearest pixel too. A plane 2 m away spans it only
// when turned more than about 80 degrees from facing the camera.
const float kBlendSpanM = 0.04;

// Raw pixel i of the image.
uint raw_at(uint i) {
  uint j = i + pc.raw_first;
  return (raw[j >> 1] >> ((j & 1u) * 16u)) & 0xFFFFu;
}

// Raw pixel i in metres, less the depth offset; 0 is no return.
float metres_at(uint i) {
  float z = float(raw_at(i)) * pc.metres_per_unit;
  return z > 0.0 ? max(z - pc.depth_offset_m, 0.0) : 0.0;
}

// a at t = 0, b at t = 1; exactly a where a == b, fused or not, so a flat
// block keeps its value.
float lerp(float a, float b, float t) { return a + (b - a) * t; }

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint w = pc.cam.width;
  uint h = pc.cam.height;
  if (gid >= w * h) {
    return;
  }
  vec2 s = source_pixel(pc.cam, vec2(float(gid % w), float(gid / w)));
  // round-half-up of the source coordinate; outside the captured image, and
  // for a NaN, no return.
  if (!rounds_into(s, w, h)) {
    depth[gid] = 0.0;
    return;
  }
  vec2 r = floor(s + 0.5);
  float z = metres_at(uint(r.y) * w + uint(r.x));
  // The 2x2 block from floor(s), which holds the nearest pixel. Where it
  // reaches past the image, the nearest pixel stands.
  vec2 o = floor(s);
  if (o.x >= 0.0 && o.y >= 0.0 && o.x + 1.0 < float(w) &&
      o.y + 1.0 < float(h)) {
    uint i = uint(o.y) * w + uint(o.x);
    float d00 = metres_at(i);
    float d10 = metres_at(i + 1u);
    float d01 = metres_at(i + w);
    float d11 = metres_at(i + w + 1u);
    float lo = min(min(d00, d10), min(d01, d11));
    float hi = max(max(d00, d10), max(d01, d11));
    if (lo > 0.0 && hi - lo <= kBlendSpanM) {
      vec2 f = s - o;
      z = lerp(lerp(d00, d10, f.x), lerp(d01, d11, f.x), f.y);
    }
  }
  if (pc.within_color != 0u && z > 0.0 &&
      !kept_with_color(vec2(float(gid % w), float(gid / w)), z)) {
    z = 0.0;
  }
  depth[gid] = z;
}
